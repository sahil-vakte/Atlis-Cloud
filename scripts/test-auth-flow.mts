import assert from 'node:assert/strict';
import { randomBytes } from 'node:crypto';
import env from '@next/env';
import mysql from 'mysql2/promise';
import bcrypt from 'bcryptjs';
import { SignJWT } from 'jose';
import { authenticator, digest } from '../lib/totp';
env.loadEnvConfig(process.cwd());
const base = process.env.AUTH_TEST_URL || 'http://localhost:3000';
const db = await mysql.createConnection({host:process.env.DB_HOST,port:Number(process.env.DB_PORT || 3306),user:process.env.DB_USER,password:process.env.DB_PASSWORD,database:process.env.DB_NAME});
const email = `auth-test-${randomBytes(8).toString('hex')}@example.invalid`, password = randomBytes(24).toString('base64url');
let id: number | undefined;
const request = async (path: string, body?: any, cookie = '') => {
  const r = await fetch(base+path, { method: body ? 'POST' : 'GET', headers: { 'content-type': 'application/json', cookie }, ...(body ? {body:JSON.stringify(body)} : {}), redirect:'manual' });
  return { r, data: await r.json().catch(()=>({})), cookie:r.headers.getSetCookie().filter(v=>!v.includes('Max-Age=0')).map(v=>v.split(';')[0]).join('; ') };
};
try {
  const [result]: any = await db.query('INSERT INTO users(first_name,last_name,email,password,role_type,status,isLogin,deleted,publicip,IsViewOnlyAccess,isUserUpdatedPassword) VALUES (?,?,?,?,1,1,1,0,1,0,1)', ['Authentication','Verification',email,await bcrypt.hash(password,10)]); id=result.insertId;
  assert.equal((await request('/api/auth/mfa')).r.status,401);
  assert.equal((await request('/api/auth/login',{email,password:'incorrect'})).r.status,401);
  const login=await request('/api/auth/login',{email,password});
  assert.equal(login.data.status,'mfa_required'); assert.ok(!login.cookie.includes('atlis_session='));
  assert.equal((await request('/api/menu',undefined,login.cookie)).r.status,401,'Password must not grant access');
  const setup=await request('/api/auth/mfa',undefined,login.cookie);
  assert.equal(setup.data.setup,true); assert.match(setup.data.qr,/^data:image\/png;base64,/);
  assert.ok(setup.data.secret);
  const secondSetup=await request('/api/auth/mfa',undefined,login.cookie); assert.equal(secondSetup.data.secret,setup.data.secret,'Refreshing setup must not change the key');
  const bad=await request('/api/auth/mfa',{code:'bad'},login.cookie); assert.equal(bad.r.status,400);
  const timestamp=Date.now(), code=authenticator(setup.data.secret).generate({timestamp});
  const verified=await request('/api/auth/mfa',{code},login.cookie);
  assert.equal(verified.r.status,200); assert.ok(verified.cookie.includes('atlis_session='));
  assert.equal((await request('/api/menu',undefined,verified.cookie)).r.status,200);
  assert.equal((await request('/api/auth/mfa',{code},login.cookie)).r.status,401,'Challenge must be consumed');
  const returning=await request('/api/auth/login',{email,password});
  const details=await request('/api/auth/mfa',undefined,returning.cookie);
  assert.deepEqual(details.data,{setup:false},'Enrolled users must never receive the QR or secret again');
  assert.equal((await request('/api/menu',undefined,returning.cookie)).r.status,401);
  assert.equal((await request('/api/auth/mfa',{code},returning.cookie)).r.status,400,'Code reuse must be rejected');
  const nextCode=authenticator(setup.data.secret).generate({timestamp:timestamp+30000});
  const results=await Promise.all([request('/api/auth/mfa',{code:nextCode},returning.cookie),request('/api/auth/mfa',{code:nextCode},returning.cookie)]);
  assert.deepEqual(results.map(v=>v.r.status).sort(),[200,401],'Concurrent verification must only succeed once');
  const old=await new SignJWT({u:{id,role:1}}).setProtectedHeader({alg:'HS256'}).setExpirationTime('1m').sign(new TextEncoder().encode(process.env.JWT_SECRET));
  assert.equal((await request('/api/menu',undefined,`atlis_session=${old}`)).r.status,401,'Pre-MFA sessions must be invalid');
  const lock=await request('/api/auth/login',{email,password});
  for(let i=0;i<5;i++) assert.equal((await request('/api/auth/mfa',{code:'bad'},lock.cookie)).r.status,i===4?429:400);
  const retry=await request('/api/auth/login',{email,password});
  assert.equal((await request('/api/auth/mfa',{code:nextCode},retry.cookie)).r.status,429,'New password challenge must not bypass lockout');
  await db.query('UPDATE app_user_mfa SET locked_until=NULL,failed_attempts=0 WHERE user_id=?',[id]);
  await db.query('UPDATE app_auth_challenges SET expires_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 MINUTE) WHERE user_id=?',[id]);
  assert.equal((await request('/api/auth/mfa',{code:nextCode},retry.cookie)).r.status,401);
  const disabled=await request('/api/auth/login',{email,password});
  await db.query('UPDATE users SET status=0 WHERE id=?',[id]);
  assert.equal((await request('/api/auth/mfa',{code:nextCode},disabled.cookie)).r.status,401);
  assert.equal((await request('/api/menu',undefined,verified.cookie)).r.status,401,'Disabled accounts must lose access');
  console.log('PASS: enrollment, QR, password-only denial, code verification, returning login, concurrent reuse denial, lockout, expiry, old-session rejection and disabled-account rejection.');
} finally {
  if(id) for(const [table,column] of [['login_logs','user_id'],['app_auth_challenges','user_id'],['app_user_mfa','user_id'],['users','id']]) await db.query('DELETE FROM ?? WHERE ??=?',[table,column,id]);
  await db.query('DELETE FROM app_auth_limits WHERE bucket=?',[digest(`email:${email}`)]);
  await db.end();
}
