# ---- Database (MySQL / MariaDB) — import atlis_dev.sql into this database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=atlis
DB_PASSWORD=atlis
DB_NAME=atlis_dev

# ---- Auth ----
# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12

# ---- App ----
APP_URL=http://localhost:3000
APP_NAME=atlis.cloud
UPLOAD_DIR=./storage/uploads

# ---- SMTP (used for activation, reset-password and template emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="atlis.cloud <no-reply@atlis.cloud>"

# Folder holding the OLD app's uploads (copy laravel/public/uploads here) so existing CVs, contracts,
# timesheets and documents keep opening. New uploads go to UPLOAD_DIR.
LEGACY_UPLOAD_DIR=./storage/legacy-uploads

# Secret for the daily reminder job: curl -H "x-cron-key: $CRON_SECRET" $APP_URL/api/cron/all
CRON_SECRET=change-me-too
