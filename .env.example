# ---- Database (MySQL / MariaDB) — import atlis_dev.sql into this database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=atlis
DB_PASSWORD=atlis
DB_NAME=atlis_dev

# ---- Auth ----
# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Independent encryption key for authenticator secrets. Generate: openssl rand -hex 32
# Keep a secure backup. Do not rotate without re-enrolling every authenticator.
MFA_ENCRYPTION_KEY=
SESSION_HOURS=12

# ---- App ----
APP_URL=http://localhost:3000
APP_NAME=atlis.cloud
UPLOAD_DIR=./storage/uploads

# ---- SMTP (used for activation, reset-password and template emails) ----
SMTP_HOST=
# Sending requires this switch AND the admin Notification emails delivery switch.
EMAIL_DELIVERY_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="atlis.cloud <no-reply@atlis.cloud>"

# Folder holding the OLD app's uploads (copy laravel/public/uploads here) so existing CVs, contracts,
# timesheets and documents keep opening. New uploads go to UPLOAD_DIR.
LEGACY_UPLOAD_DIR=./storage/legacy-uploads
# Local S3 backup, with profileID/filename folders; checked before cloud storage.
LEGACY_CV_BACKUP_DIR=
# Original CV bucket (keys are profileID/filename). Uses the AWS default credential chain.
LEGACY_CV_S3_BUCKET=
AWS_REGION=

# Secret for the daily reminder job: curl -H "x-cron-key: $CRON_SECRET" $APP_URL/api/cron/all
CRON_SECRET=change-me-too

# ---- Avrix CRM hub (avrix-marketing → Admin → Applications → atlis.cloud CRM → Generate key) ----
# Copies CRM prospects (company + key contact) into the shared CRM. Call /api/cron/crm-sync every 15 minutes.
AVRIX_CRM_URL=
AVRIX_CRM_KEY=
AVRIX_CRM_SECRET=
