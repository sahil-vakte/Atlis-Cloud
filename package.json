    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.76.0",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.6",
    "next": "14.2.35",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.11.0",
    "tesseract.js": "^7.0.0",
